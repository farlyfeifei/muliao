      "files": [
        {
          "name": "tokens.txt",
          "size_bytes": 56317,
          "purpose": "Token symbol table"
        },
        {
          "name": "encoder-epoch-99-avg-1.onnx",
          "size_bytes": 330083505,
          "purpose": "Streaming Zipformer encoder network"
        },
        {
          "name": "decoder-epoch-99-avg-1.onnx",
          "size_bytes": 13876452,
          "purpose": "Transducer prediction decoder network"
        },
        {
          "name": "joiner-epoch-99-avg-1.onnx",
          "size_bytes": 12833618,
          "purpose": "Transducer encoder-decoder joiner network"
        },
        {
          "name": "bpe.model",
          "size_bytes": 244836,
          "purpose": "SentencePiece BPE vocabulary model"
        }
      ],
      "source": "https://huggingface.co/csukuangfj/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20"
    },
    "vits_tts": {
      "purpose": "Optional fully local VITS speech synthesis",
