      "files": [
        {
          "name": "model.int8.onnx",
          "size_bytes": 239233841,
          "purpose": "SenseVoice-Small quantized acoustic and language model"
        },
        {
          "name": "tokens.txt",
          "size_bytes": 315894,
          "purpose": "SenseVoice token symbol table"
        }
      ],
      "source": "https://hf-mirror.com/csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17"
    },
    "streaming_zipformer": {
      "purpose": "Display-only streaming Chinese and English captions",
      "runtime": "sherpa-onnx",
